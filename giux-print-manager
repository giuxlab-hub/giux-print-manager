def cmd(args,timeout=10):
    try:
        p=subprocess.run(args,capture_output=True,text=True,timeout=timeout)
        return (p.returncode==0,(p.stdout+p.stderr).strip())
    except (OSError,subprocess.TimeoutExpired) as e:return (False,str(e))
def scanner_environment(profiles):
    """Provide an isolated SANE config for declared eSCL profiles only.

    This avoids slow backend-wide discovery and does not alter /etc/sane.d.
    """
    directory = Path.home() / ".cache/giux-print-manager/sane"
    directory.mkdir(parents=True, exist_ok=True)
    (directory / "dll.conf").write_text("airscan\n", encoding="utf-8")
    lines = ["[devices]"]
    for p in profiles:
        url = p.get("scanner_url", "")
        if url.startswith(("http://", "https://")) and "\n" not in url:
            lines.append(p["id"] + " = " + url + ", eSCL")
    lines.extend(["[options]", "discovery = disable", ""])
    (directory / "airscan.conf").write_text("\n".join(lines), encoding="utf-8")
    return {**os.environ, "SANE_CONFIG_DIR": str(directory)}

class ScanPreview(Gtk.DrawingArea):
    """Preview with mouse-drag rectangle in image-relative coordinates."""
    def __init__(self):
        super().__init__()
        self.set_size_request(380, 290)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.POINTER_MOTION_MASK)
        self.connect("draw", self.paint)
        self.connect("button-press-event", self.press)
        self.connect("motion-notify-event", self.motion)
        self.connect("button-release-event", self.release)
        self.pixbuf = None
        self.selection = None
        self.start = None
        self.dragging = False
        self.geometry = (0, 0, 1, 1)

    def load_image(self, path):
        self.pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
        self.selection = None
        self.queue_draw()

    def clear(self):
        self.selection = None
        self.queue_draw()

    def image_coords(self, px, py):
        x, y, width, height = self.geometry
        return (max(0.0, min(1.0, (px-x)/width)),
                max(0.0, min(1.0, (py-y)/height)))

    def paint(self, widget, ctx):
        allocation=self.get_allocation()
        ctx.set_source_rgb(0.94, 0.94, 0.94)
        ctx.paint()
        if self.pixbuf is None:
            return False
        iw,ih=self.pixbuf.get_width(),self.pixbuf.get_height()
        scale=min(allocation.width/iw,allocation.height/ih)
        width,height=max(1,round(iw*scale)),max(1,round(ih*scale))
        x=(allocation.width-width)/2
        y=(allocation.height-height)/2
        self.geometry=(x,y,width,height)
        display=self.pixbuf.scale_simple(width,height,GdkPixbuf.InterpType.BILINEAR)
        Gdk.cairo_set_source_pixbuf(ctx,display,x,y)
        ctx.paint()
        if self.selection:
            a,b,c,d=self.selection
            left=x+min(a,c)*width
            top=y+min(b,d)*height
            rw=abs(c-a)*width
            rh=abs(d-b)*height
            ctx.set_source_rgba(0.0,0.45,0.9,0.20)
            ctx.rectangle(left,top,rw,rh)
            ctx.fill_preserve()
            ctx.set_source_rgba(0.0,0.30,0.85,1.0)
            ctx.set_line_width(2)
            ctx.stroke()
        return False

    def press(self, widget, event):
        if event.button==1 and self.pixbuf is not None:
            self.start=self.image_coords(event.x,event.y)
            self.selection=(*self.start,*self.start)
            self.dragging=True
            self.queue_draw()
        return True

    def motion(self, widget, event):
        if self.dragging and self.start:
            self.selection=(*self.start,*self.image_coords(event.x,event.y))
            self.queue_draw()
        return True

    def release(self, widget, event):
        if self.dragging and event.button==1:
            self.dragging=False
            a,b=self.start
            c,d=self.image_coords(event.x,event.y)
            self.selection=(a,b,c,d) if abs(c-a)>0.01 and abs(d-b)>0.01 else None
            self.queue_draw()
        return True

    def crop_fraction(self):
        if not self.selection:
            return None
        a,b,c,d=self.selection
        return min(a,c),min(b,d),abs(a-c),abs(b-d)

def load_profiles():
    profiles=[]
    for folder in (PROFILES,HOME_PROFILES):
        if folder.is_dir():
            for f in sorted(folder.glob("*.json")):
                try:
                    p=json.loads(f.read_text(encoding="utf-8"))
                    assert isinstance(p["match"],str) and isinstance(p["photo_media"],list)
                    profiles.append(p)
                except (KeyError,ValueError,AssertionError,OSError):pass
    return profiles
