    def discover_scanners(self,*_):
        def discover():
            try:
                p=subprocess.run(["scanimage","-L"],env=self.scan_env,capture_output=True,text=True,timeout=12)
                ok,out=(p.returncode==0),(p.stdout+p.stderr).strip()
            except (OSError,subprocess.TimeoutExpired) as exc:
                return False,str(exc)
            devices=re.findall(r"device \`([^']+)'",out)
            if devices:return True,devices
            return False,out[:300] or "No SANE scanners detected"
        self.background(discover,self.found_scanners)
    def found_scanners(self,r):
        ok,devs=r
        if not ok:return self.result(r)
        self.scanner.remove_all()
        for name in devs:self.scanner.append(name,name)
        self.scanner.set_active(0)
        self.notice.set_text(str(len(devs))+" scanner(s)")
        return False
    def choose_dest(self,*_):
        d=Gtk.FileChooserDialog(title=self.tr("save"),transient_for=self,action=Gtk.FileChooserAction.SAVE)
        d.add_buttons(self.tr("cancel"),Gtk.ResponseType.CANCEL,self.tr("ok"),Gtk.ResponseType.OK)
        d.set_current_name("scan.png")
        d.set_do_overwrite_confirmation(True)
        if d.run()==Gtk.ResponseType.OK:self.dest.set_text(d.get_filename())
        d.destroy()
    def open_image_ocr(self,*_):
        chooser=Gtk.FileChooserDialog(title=self.tr("openocr"),transient_for=self,
                                      action=Gtk.FileChooserAction.OPEN)
        chooser.add_buttons(self.tr("cancel"),Gtk.ResponseType.CANCEL,
                            self.tr("ok"),Gtk.ResponseType.OK)
        flt=Gtk.FileFilter()
        flt.set_name("Raster image")
        for pat in ("*.png","*.jpg","*.jpeg","*.tif","*.tiff","*.PNG","*.JPG"):
            flt.add_pattern(pat)
        chooser.add_filter(flt)
        path=chooser.get_filename() if chooser.run()==Gtk.ResponseType.OK else None
        chooser.destroy()
        if path:self.show_ocr(path)

    def show_ocr(self,path):
        try:
            with Image.open(path) as img:img.verify()
            window=OCRWorkspace(str(path),"it" if self.lang==0 else "en")
            window.set_transient_for(self)
            self.ocr_windows.append(window)
            window.connect("destroy",lambda w:self.ocr_windows.remove(w) if w in self.ocr_windows else None)
            window.show_all()
        except Exception as e:self.dialog("error",str(e))

    def scan_finished(self,result):
        self.result(result)
        if result[0]:
            self.show_ocr(result[1])
        return False

    def scanner_device(self):
        return self.scanner.get_active_id() or self.scanner.get_child().get_text().strip()

    def scan_preview_start(self,*_):
        dev=self.scanner_device()
        if not dev:
            self.dialog("error","Discover and select scanner first")
            return
        # Preview always uses the glass, where geometry has a defined origin.
        self.scan_preview.clear()
        def work():
            with tempfile.NamedTemporaryFile(suffix=".png",delete=False) as f:
                path=Path(f.name)
            args=["scanimage","-d",dev,"--resolution","100","--mode","Color",
                  "--source","Flatbed","--format=png","--scan-intent=Preview"]
            try:
                with path.open("wb") as output:
                    r=subprocess.run(args,env=self.scan_env,stdout=output,
                                     stderr=subprocess.PIPE,timeout=120)
                if r.returncode:
                    return False,r.stderr.decode(errors="replace")[:800]
                with Image.open(path) as img:
                    img.verify()
                return True,str(path)
            except Exception as e:
                return False,str(e)
            finally:
                # Success is decoded by the UI before removing the temporary file.
                if not path.stat().st_size:
                    path.unlink(missing_ok=True)
        self.background(work,self.preview_loaded)

    def preview_loaded(self,result):
        good,path=result
        if not good:
            return self.result(result)
        try:
            self.scan_preview.load_image(path)
            self.notice.set_text("Preview: drag to select a crop area")
        except Exception as exc:
            self.dialog("error",exc)
        finally:
            Path(path).unlink(missing_ok=True)
        return False

    def scan(self,*_):
        dev=self.scanner_device()
        if not dev:self.dialog("error","Discover and select scanner first");return
        target=Path(self.dest.get_text()).expanduser()
        if target.suffix.lower() not in (".png",".jpg",".jpeg",".tif",".tiff") or not target.parent.is_dir():
            self.dialog("error","Choose an existing directory and a .png/.jpg/.tiff filename");return
        if not self.dialog("confirm",str(target),True):return
        args=["scanimage","-d",dev,"--resolution",self.dpi.get_active_id(),"--mode",self.mode.get_active_id(),"--format=png"]
        source=self.source.get_active_id()
        crop=self.scan_preview.crop_fraction()
        if source!="auto":
            args+=["--source",source]
        if crop and source=="ADF":
            self.dialog("error","Region selection is supported for Flatbed, not ADF.")
            return
        if crop:
            # Both supported flatbeds have ~215.9 x 297 mm geometry.
            # Use actual known bounds of the supported devices, with a safety margin.
            width_mm=215.9
            height_mm=296.9 if "brother" in dev.casefold() else 297.0
            a,b,w,h=crop
            x=a*width_mm; y=b*height_mm
            sw=min(w*width_mm,width_mm-x)
            sh=min(h*height_mm,height_mm-y)
            if sw<2 or sh<2:
                self.dialog("error","Selected area is too small.")
                return
            args+=["-l",f"{x:.2f}","-t",f"{y:.2f}","-x",f"{sw:.2f}","-y",f"{sh:.2f}"]
        def work():
            with tempfile.NamedTemporaryFile(suffix=".png",delete=False) as f:temp=Path(f.name)
            try:
                with temp.open("wb") as fp:
                    proc=subprocess.run(args,env=self.scan_env,stdout=fp,stderr=subprocess.PIPE,timeout=150)
                if proc.returncode:return False,proc.stderr.decode(errors="replace")[:900]
                with Image.open(temp) as im:im.save(target)
                return True,str(target)
            finally:temp.unlink(missing_ok=True)
        self.background(work,self.scan_finished)
    def xsane(self,*_):
        try:subprocess.Popen(["xsane"])
        except OSError as e:self.dialog("error",e)
    def build_modules(self):
        box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=12,margin=12)
        box.pack_start(self.label("module-note"),False,False,0)
        for p in self.profiles:box.pack_start(Gtk.Label(label=str(p.get("id"))+" / "+p["match"],xalign=0),False,False,0)
        self.pages.append_page(box,self.label("modules"))

